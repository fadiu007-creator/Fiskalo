{
  "name": "fiskalo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "cf-build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:products": "node --experimental-strip-types --test tests/product-tax.test.mjs tests/product-units.test.mjs tests/product-categories.test.mjs tests/unique-fiscalization-code.test.mjs",
    "test:offline": "node --experimental-strip-types --test tests/offline-ledger.test.mjs tests/atk-protobuf.test.mjs tests/offline-outage-time.test.mjs tests/article44-export.test.mjs",
    "test:atk-heartbeat": "node --experimental-strip-types --test tests/atk-heartbeat.test.mjs tests/atk-heartbeat-key-provisioning.test.mjs",
    "test:payments": "node --experimental-strip-types --test tests/payment-allocation.test.mjs tests/correction-idempotency.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.9.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.29",
    "@eslint/eslintrc": "3.3.1",
    "@opennextjs/cloudflare": "1.20.16",
    "wrangler": "^4.148.0",
    "@types/qrcode": "^1.5.5"
  }
}
