NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the Cloudflare ATK gateway to persist ATK-confirmed receipts.
# Set as a Cloudflare Worker secret; never prefix with NEXT_PUBLIC_.
