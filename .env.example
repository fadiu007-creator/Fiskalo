NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only PKCS#8 P-256 heartbeat signing key. Set as a Cloudflare Worker secret.
# Never prefix this value with NEXT_PUBLIC_ and never commit a populated value.
ATK_HEARTBEAT_PRIVATE_KEY_PEM=

# Server-only Supabase service-role key. Configure as a Cloudflare Worker secret.
# Never expose this value to browser code or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
